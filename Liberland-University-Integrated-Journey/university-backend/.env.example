# Same Stripe sandbox. Live keys are rejected by the application.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# npm run stripe:listen fills this automatically without printing it.
STRIPE_WEBHOOK_SECRET=

# Leave empty for local review. Set this exact public HTTPS origin behind IIS.
PUBLIC_ORIGIN=
# The IIS deployment script uses a separate, persistent environment file and DATA_DIR.

# Password-free staff testing, isolated under DATA_DIR/demo. Restart after changing.
DEMO_MODE=false
